# Environment — copy to .env.local for local development.
# Only free-tier services are used. Every variable below has a free path.

# ── Database (Supabase Free) ────────────────────────────────────────────────
# Pooled connection string (port 6543, transaction mode) used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=20"
# Direct connection (port 5432) used by Prisma Migrate / db push.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── football-data.org (Free plan: 10 requests / minute) ─────────────────────
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=""

# ── App access ──────────────────────────────────────────────────────────────
# Shared code for you and a few friends. Leave empty to disable the gate locally.
APP_ACCESS_CODE=""
# Random 32+ char string used to sign the session cookie: openssl rand -base64 32
AUTH_SECRET=""

# ── Cron ────────────────────────────────────────────────────────────────────
# Protects /api/cron/*. Vercel sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=""

# ── Mode ────────────────────────────────────────────────────────────────────
# auto  → demo data when DATABASE_URL or FOOTBALL_DATA_API_KEY is missing
# on    → always use the deterministic demo dataset (no DB, no API calls)
# off   → always use Supabase + football-data.org
DEMO_MODE="auto"

# How long a fixture board is considered fresh (seconds). Keep this generous:
# every revalidation is a potential API request.
BOARD_REVALIDATE_SECONDS="900"
# Minimum minutes between lazy background syncs.
SYNC_MIN_INTERVAL_MINUTES="30"
